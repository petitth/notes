#!/bin/bash

#
# Trim a string.
#

# internal field separator (allow blank spaces in strings)
IFS=$(echo -en "\n\b")

trim() {
  result=`echo $1 | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'`
  echo "$result"
}

echo "-- begin --"
str=" hello world "
trimmed=$(trim $str)
echo "trimmed string = '$trimmed'"
echo "-- end --"
exit 0